            padding: 30px;
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            display: flex;
            justify-content: center;
        }

        .chat-container {
            width: 420px;
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
            overflow: hidden;
        }

        .chat-header {
            padding: 16px;
            background-color: #2563eb;
            color: white;
            font-size: 20px;
            font-weight: bold;
        }

        #chatMessages {
            height: 460px;
            padding: 16px;
            overflow-y: auto;
        }

        .message {
            max-width: 78%;
            padding: 10px 14px;
            margin: 8px 0;
            border-radius: 12px;
            line-height: 1.4;
            white-space: pre-wrap;
        }

        .user-message {
            margin-left: auto;
            background-color: #2563eb;
            color: white;
        }

        .bot-message {
            background-color: #e5e7eb;
            color: #111827;
        }

        .input-row {
            display: flex;
            padding: 12px;
            border-top: 1px solid #dddddd;
        }

        .input-row input {
            flex: 1;
            padding: 10px;
        }

        .input-row button {
            margin-left: 8px;
            padding: 10px 16px;
        }
    </style>
</head>

<body>
    <div class="chat-container">
        <div class="chat-header">
            AI Data Engineering Assistant
        </div>

        <div id="chatMessages">
            <div class="message bot-message">
                Hello! How can I help you?
            </div>
        </div>

        <div class="input-row">
            <input
                id="messageInput"
                placeholder="Enter your question"
                autocomplete="off"
            >

            <button id="sendButton">
                Send
            </button>
        </div>
    </div>

    <script>
        const conversationHistory = [];

        const input = document.getElementById("messageInput");
        const sendButton = document.getElementById("sendButton");
        const chatMessages = document.getElementById("chatMessages");

        sendButton.addEventListener("click", sendMessage);

        input.addEventListener("keydown", (event) => {
            if (event.key === "Enter") {
                sendMessage();
            }
        });

        function addMessage(text, className, id = "") {
            const element = document.createElement("div");

            element.classList.add("message", className);
            element.textContent = text;

            if (id) {
                element.id = id;
            }

            chatMessages.appendChild(element);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function removeThinkingMessage() {
            const thinkingMessage =
                document.getElementById("thinkingMessage");

            if (thinkingMessage) {
                thinkingMessage.remove();
            }
        }

        async function sendMessage() {
            const message = input.value.trim();

            if (!message) {
                return;
            }

            addMessage(message, "user-message");

            input.value = "";
            sendButton.disabled = true;

            addMessage(
                "Thinking...",
                "bot-message",
                "thinkingMessage"
            );

            try {
                const response = await fetch("/api/chat", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        message,
                        history: conversationHistory
                    })
                });

                const data = await response.json();

                removeThinkingMessage();

                if (!response.ok) {
                    throw new Error(
                        data.error || "Request failed"
                    );
                }

                addMessage(data.reply, "bot-message");

                conversationHistory.push({
                    role: "user",
                    content: message
                });

                conversationHistory.push({
                    role: "assistant",
                    content: data.reply
                });

                if (conversationHistory.length > 10) {
                    conversationHistory.splice(
                        0,
                        conversationHistory.length - 10
                    );
                }
            } catch (error) {
                removeThinkingMessage();

                addMessage(
                    error.message || "Unable to contact the AI service.",
                    "bot-message"
                );

                console.error(error);
            } finally {
                sendButton.disabled = false;
                input.focus();
            }
        }
    </script>
</body>
</html>
```

The frontend uses `textContent`, rather than directly inserting model output as HTML. This prevents returned text from being interpreted as executable markup.

